//--- OBJECT WRITE BEGIN ---
new SimGroup(MissionGroup) {

   // TGE's MissionInfo ScriptObject, whose name and desc0 the loading screen
   // read.  Here that job belongs to LevelInfo, and the object must be called
   // theLevelInfo -- core/scripts/server/levelInfo.cs sends
   // theLevelInfo.levelName and theLevelInfo.desc[n] by that name.
   //
   // LevelInfo also absorbs what the old Sky object carried besides the sky
   // itself: the view distance and the fog.  TGE's fog was a distance ramp
   // (fogDistance = 300 out of visibleDistance = 500); this engine's is
   // exponential, so the ramp becomes a density with an offset at the distance
   // the old one started at.
   new LevelInfo(theLevelInfo) {
      nearClip = "0.1";
      visibleDistance = "500";
      decalBias = "0.0015";
      fogColor = "0.82 0.828 0.844 1";
      fogDensity = "0.002";
      fogDensityOffset = "300";
      fogAtmosphereHeight = "100";
      canvasClearColor = "209 212 215 255";
         desc0 = "Five apples on a flat plain.  Walk over all five.";
         LevelName = "The Orchard";
   };

   // Replaces both the Sky and the Sun.
   //
   // TGE's Sky drew a cube of six .jpgs listed in a .dml, with cloud layers on
   // top; neither the class nor the .dml loader exists here.  ScatterSky is what
   // this engine's own levels use -- it renders the sky analytically AND is the
   // scene's directional light (it implements ISceneLight), so the separate Sun
   // object is gone too.  azimuth and elevation are the old Sun's.
   //
   // data/skies/ is therefore unreferenced now.  Putting that art back means a
   // SkyBox plus a CubemapData built from the six day_000N.jpg faces, and
   // working out which TGE face belongs on which cubemap face.
   new ScatterSky() {
      azimuth = "0";
      elevation = "35";
      skyBrightness = "30";
      sunScale = "0.988 0.985 0.98 1";
      ambientScale = "0.5 0.5 0.5 1";
      sunBrightness = "50";
      brightness = "1";
      exposure = "0.85";
      mieScattering = "0.0015";
      rayleighScattering = "0.0035";
      castShadows = "1";
      shadowType = "PSSM";
      texSize = "1024";
      shadowDistance = "400";
      shadowSoftness = "0.25";
      numSplits = "4";
      logWeight = "0.96";
      overDarkFactor = "3000 2000 1000 250";
      fadeStartDistance = "325";
      attenuationRatio = "0 1 1";
      nightColor = "0.0196078 0.0117647 0.109804 1";
      moonEnabled = "1";
      moonTexture = "core/art/skies/night/moon_wglow";
      moonScale = "0.3";
      moonTint = "0.192157 0.192157 0.192157 1";
      useNightCubemap = "0";
      position = "0 0 0";
      rotation = "1 0 0 0";
      scale = "1 1 1";
   };

   // orchard.ter is a TGE-era terrain: 256x256 samples, file version 3.  It is
   // loaded unconverted -- TerrainFile::load sends anything below version 7 to
   // _loadLegacy(), which reads exactly that layout, and the one material name
   // stored in it ("apple-picker/data/terrains/checkerboard2") is resolved by
   // TerrainMaterial::findOrCreate() into a material built from the .png at
   // that path.  Which is why this project has to sit inside the game
   // directory: that string is relative to the working directory, and it is
   // baked into the binary.
   //
   // 256 samples at squareSize 8 is 2048m across, so -1024 -1024 centres it on
   // the origin.  The heightmap is all zeros, which is what makes z = 0 the
   // ground everywhere -- see pickSpawnPoint() in server/game.cs.
   new TerrainBlock(Terrain) {
      terrainFile = "./orchard.ter";
      squareSize = "8";
      tile = "1";
      baseTexSize = "1024";
      screenError = "16";
      position = "-1024 -1024 0";
      rotation = "1 0 0 0";
      scale = "1 1 1";
   };

   // The drop point.  18m south of the ring of apples, looking north, so the
   // whole game is in frame the moment the loading screen comes down.  Only x
   // and y are used; pickSpawnPoint() puts the player on the ground itself.
   new SimGroup(PlayerDropPoints) {

      new SpawnSphere() {
         dataBlock = "SpawnSphereMarker";
         autoSpawn = "0";
         radius = "1";
         sphereWeight = "1";
         indoorWeight = "1";
         outdoorWeight = "1";
         position = "0 -18 1";
         rotation = "0 0 1 0";
         scale = "1 1 1";
      };
   };
};
//--- OBJECT WRITE END ---
